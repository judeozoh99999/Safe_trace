rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ── Users collection rules ──
    // Allow read so phone lookup (checkPhoneExists / getEmailForPhone) works during login/registration
    // Allow write/update/create for the document owner
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null;
      
      // Notifications subcollection
      match /notifications/{notifId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Favourites subcollection
      match /favourites/{favId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Contacts subcollection
      match /contacts/{contactId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Locations subcollection
      match /locations/{locId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Location logs subcollection
      match /location_logs/{logId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Location history subcollection
      match /location_history/{histId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      // Wildcard rule for any other user subcollections
      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ── OTP verification rules ──
    // Unauthenticated users during sign up & login must read/write their email OTP
    match /otps/{otpId} {
      allow read, write: if true;
    }

    // ── Trigger Email extension rules ──
    // Unauthenticated & authenticated users can queue verification emails
    match /mail/{mailId} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // ── Nearby connections collection rules ──
    match /nearby_connections/{connId} {
      allow read, write: if request.auth != null && 
        (request.auth.uid == resource.data.requester_uid || 
         request.auth.uid == resource.data.recipient_uid ||
         request.auth.uid == request.resource.data.requester_uid ||
         request.auth.uid == request.resource.data.recipient_uid);
    }
    
    // ── Nearby sessions collection rules ──
    match /nearby_sessions/{sessId} {
      allow read, write: if request.auth != null;
    }

    // ── active_panics collection rules ──
    match /active_panics/{panicId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.notified_contacts;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
      allow update: if request.auth != null && 
        request.auth.uid == resource.data.uid && 
        request.auth.uid == request.resource.data.uid;
      allow delete: if false;
    }

    // ── community_notes collection rules ──
    match /community_notes/{noteId} {
      allow read: if request.auth != null && resource.data.is_visible == true;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
      allow update: if false;
      allow delete: if request.auth != null && request.auth.uid == resource.data.uid;
    }

    // ── nearby_alert_events collection rules ──
    match /nearby_alert_events/{eventId} {
      allow read: if request.auth != null && 
        (request.auth.uid == resource.data.requester_uid || 
         request.auth.uid == resource.data.recipient_uid || 
         request.auth.uid in resource.data.visible_to);
      allow create, update, delete: if false;
    }

    // ── trusted_circle_requests collection rules ──
    match /trusted_circle_requests/{requestId} {
      allow read: if request.auth != null && 
        (request.auth.uid == resource.data.requester_uid || 
         request.auth.uid == resource.data.recipient_uid ||
         request.auth.uid == resource.data.deletion_initiated_by);
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.requester_uid;
      allow update: if request.auth != null && 
        (request.auth.uid == resource.data.requester_uid || 
         request.auth.uid == resource.data.recipient_uid ||
         request.auth.uid == resource.data.deletion_initiated_by);
      allow delete: if request.auth != null && 
        (request.auth.uid == resource.data.requester_uid || 
         request.auth.uid == resource.data.recipient_uid);
    }

    // ── ai_summaries & gemini_usage (Admin SDK only) ──
    match /ai_summaries/{summaryId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /gemini_usage/{usageId} {
      allow read, write: if false;
    }
  }
}
